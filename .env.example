# Copy to .env and fill in DEVELOPMENT values. `node server.js` and the scripts read .env
# (variables already set in the shell, or by Railway, win). .env is Git-ignored; never commit
# real values here. Production values belong in Railway's variables only.

# --- Records: Postgres (Supabase pooler connection string). Unset: JSON files under data/.
DATABASE_URL=

# --- Media: Cloudflare R2 bucket. Set all four or none. The token needs Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Google login (all three, or none for login off); PUBLIC_URL is the https origin users open
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
PUBLIC_URL=

# --- Credits: the JSON of billing/config.json on one line (unset: credits off)
VIRTUALLY_BILLING_CONFIG=

# --- Video generation: provider keys (see README "API keys")
WAVESPEED_API_KEY=
# Optional: ANIMATE_DEFAULT_ROUTE, ANIMATE_MEDIA_RELAY, ANIMATE_CONCURRENCY, ANIMATE_PROMPT_SUFFIX, ANIMATE_CUSTOM_ROUTES

# --- 자동 반응 (AI director): motions picked from what the streamer says
# 자동 반응 picks with GPT-6 Luna (OPENAI_API_KEY) by default; the 방송 화면 switches to Clef-flash or Jev.
# TYPESAFE_API_KEY: Jev. CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN (Workers AI): Clef-flash.
TYPESAFE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# OPENAI_API_KEY: the Decisions API (falls back to Chat Completions when the account lacks the preview).
# SONIOX_API_KEY: real-time Korean speech-to-text for the microphone (without it: typed lines only).
OPENAI_API_KEY=
SONIOX_API_KEY=
# Optional: DIRECTOR_DRIVER=auto|decisions|chat, DIRECTOR_MODEL=gpt-6-luna, DIRECTOR_REASONING=none

# --- Server (optional)
# HOST=0.0.0.0
# PORT=8787
# NODE_ENV=production  # refuses to start without DATABASE_URL
